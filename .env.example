# Solana Arb Bot environment example

# RPC endpoints
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Wallet
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Jupiter API key (optional)
JUPITER_API_KEY=

JITO_UUID=your-jito-uuid-here

# Tips & thresholds
JITO_TIP_LAMPORTS=10000
MIN_PROFIT_PCT=1.0
MIN_PROFIT_USD=0.50

# Trade parameters
TRADE_SIZE_SOL=0.1
TRADE_SIZES=0.05,0.172,0.5
MAX_SLIPPAGE_BPS=50
SCAN_INTERVAL_MS=1000
DRY_RUN=true
MAX_TRADES_PER_MINUTE=5

# Binance/Jupiter/price settings would go here if needed
LOG_LEVEL=INFO
TRADE_SIZES=0.05,0.172,0.5
"} to=functions.read ettesෘ  {/root/.openclaw/workspace/solana-arb-bot/.env.example
# Pre-flight simulation — skips trades that would fail (default: true)
SIMULATE_BEFORE_EXECUTE=true
