# ─── Solana RPC ──────────────────────────────────────────────────────────────
# Use a private RPC for production (Helius, Triton, QuickNode, etc.)
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# ─── Wallet ───────────────────────────────────────────────────────────────────
# Base58-encoded private key — KEEP THIS SECRET, never commit to git
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ─── Jito Configuration ───────────────────────────────────────────────────────
# UUID from https://jito.network — used as Bearer token
# Leave blank to still run in DRY_RUN mode without auth
JITO_UUID=your-jito-uuid-here

# Minimum tip in lamports (10000 = 0.00001 SOL)
# Actual tip = max(JITO_TIP_LAMPORTS, 1% of expected profit)
JITO_TIP_LAMPORTS=10000

# ─── Opportunity Thresholds ───────────────────────────────────────────────────
# Flag opportunity if profit >= 1% OR >= $0.50 USD
MIN_PROFIT_PCT=1.0
MIN_PROFIT_USD=0.50

# ─── Trade Parameters ─────────────────────────────────────────────────────────
# Size of each trade leg in SOL equivalent
TRADE_SIZE_SOL=0.1

# Max slippage tolerance in basis points (50 = 0.5%)
MAX_SLIPPAGE_BPS=50

# ─── Bot Behaviour ────────────────────────────────────────────────────────────
# How often to scan for opportunities (milliseconds)
SCAN_INTERVAL_MS=1000

# Set to false to enable live trading — START WITH TRUE
DRY_RUN=true

# Max trade executions per 60-second window
MAX_TRADES_PER_MINUTE=5

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
